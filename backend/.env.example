# PageTurn Library Management System - Environment Configuration
# Copy this file to .env and set your dedicated project database password

PORT=5000

# Oracle Database Connection Settings
# Pluggable database service name:
#   Oracle 21c/23ai Free: localhost:1521/FREEPDB1
#   Oracle 18c/19c/XE:    localhost:1521/XEPDB1
#   Oracle Enterprise:   localhost:1521/ORCLPDB
DB_USER=pageturn_app
DB_PASSWORD=YOUR_NEW_PASSWORD
DB_CONNECT_STRING=localhost:1521/FREEPDB1

# Connection Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_INCREMENT=2
